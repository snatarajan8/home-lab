<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd user agent for the homelab metric agent.

  Install:
    1. Edit ProgramArguments below so the path points at this directory's
       push-metrics script (absolute path).
    2. cp com.homelab.metricagent.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.homelab.metricagent.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.homelab.metricagent.plist
    rm ~/Library/LaunchAgents/com.homelab.metricagent.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.homelab.metricagent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/REPLACE/WITH/ABSOLUTE/PATH/TO/pc-agent/push-metrics</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/homelab-metric-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/homelab-metric-agent.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
