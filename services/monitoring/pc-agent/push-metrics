#!/bin/bash
# push-metrics — Start the metric push agent for this device.
# Runs on WSL on any auxiliary PC. Pushes metrics to the Halo's Pushgateway.
# Usage: ./push-metrics [config.yaml]

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG="${1:-$SCRIPT_DIR/config.yaml}"

if ! command -v python3 &>/dev/null; then
    echo "Error: python3 not found. Install with: sudo apt install python3 python3-pip"
    exit 1
fi

if ! python3 -c "import psutil" &>/dev/null 2>&1; then
    echo "Installing dependencies..."
    pip3 install -r "$SCRIPT_DIR/requirements.txt"
fi

echo "Starting metric agent (config: $CONFIG)..."
exec python3 "$SCRIPT_DIR/agent.py" -c "$CONFIG"
