#!/bin/bash
# push-metrics — Start the metric push agent for this device (Linux / macOS).
# Pushes metrics to the Halo's Pushgateway. For Windows, use push-metrics.ps1.
# Usage: ./push-metrics [config.yaml]

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG="${1:-$SCRIPT_DIR/config.yaml}"
VENV_DIR="$SCRIPT_DIR/.venv"

if ! command -v python3 &>/dev/null; then
    echo "Error: python3 not found."
    echo "  Linux: sudo apt install python3 python3-pip python3-venv"
    echo "  macOS: brew install python  (or use the python.org installer)"
    exit 1
fi

if [ ! -d "$VENV_DIR" ]; then
    echo "Creating virtual environment..."
    python3 -m venv "$VENV_DIR"
fi

source "$VENV_DIR/bin/activate"

if ! python3 -c "import psutil" &>/dev/null 2>&1; then
    echo "Installing dependencies..."
    pip install -r "$SCRIPT_DIR/requirements.txt"
fi

echo "Starting metric agent (config: $CONFIG)..."
exec python3 "$SCRIPT_DIR/agent.py" -c "$CONFIG"
